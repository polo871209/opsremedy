    "@larksuiteoapi/node-sdk": "1.76.0",
    "jose": "^6.2.15",
    "kafkajs": "^2.2.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
